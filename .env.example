# Discord
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-client-id-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# LLM Provider (google | openai | anthropic | groq)
MODEL_PROVIDER=groq
MODEL_NAME=qwen/qwen3.8-27b

# Provider API Keys — only the one matching MODEL_PROVIDER is required
GROQ_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Image generation (optional — required for NSFW image generation)
POLLINATIONS_API_KEY=
